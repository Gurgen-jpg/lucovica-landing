# ── Время сборки ─────────────────────────────────────────────
# Канонический адрес сайта (canonical, sitemap, Open Graph)
SITE_URL=https://lucovica.ru
# ID счётчика Яндекс Метрики; пусто — счётчик не подключается
YM_ID=
# Ссылка на профиль в MAX; пусто — кнопка MAX скрыта
MAX_URL=

# ── Время выполнения ─────────────────────────────────────────
PORT=3000

# Telegram-бот для уведомлений о заявках
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта Timeweb (SMTP_USER — и логин, и адрес отправителя)
SMTP_USER=info@lucovica.ru
SMTP_PASS=
NOTIFY_EMAIL=info@lucovica.ru
